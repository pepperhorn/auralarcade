---
import AuralTrainer from "../components/AuralTrainer";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A gamified aural test trainer for rhythm, pitch, intervals, harmony, cadences, and memory work."
    />
    <title>Aural Arcade</title>
    {import.meta.env.PROD && (
      <script is:inline defer src="https://analytics.pepperhorn.com/script.js" data-website-id="3970ecd3-80fa-4933-b280-108ccaf2d2bc"></script>
    )}
  </head>
  <body>
    <AuralTrainer client:load />
  </body>
</html>
